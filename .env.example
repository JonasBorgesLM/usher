# Copy to .env and fill in real values for local development:
#
#   cp .env.example .env
#
# .env is gitignored and must never be committed (RNF-03) — real secrets
# always come from the environment, never from a file in this repository.
# The placeholders below are exactly that: placeholders, not defaults meant
# to be used as-is.

POSTGRES_DB=usher
POSTGRES_USER=usher
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me

# usher's own issuer identity (RS-29) -- an absolute URL, carried as iss on
# every token and every /authorize redirect. Must be byte-identical to
# RESOURCE_SERVER_ISSUER below (docker-compose.yml already sets that one
# from this same variable); it does not need to be a reachable address,
# only an exact string both sides compare against.
USHER_ISSUER=http://localhost:8080

# RS-12a's CSRF signing key: 32+ random bytes, hex-encoded, stable across
# restarts (moat/csrf.New's own doc comment: regenerating it per process
# rejects every token a previous process issued). Generate one with:
#
#   openssl rand -hex 32
#
# There is no safe default to ship here -- unlike POSTGRES_PASSWORD and
# REDIS_PASSWORD above, "change-me" would decode as valid (if predictable)
# hex and pass USHER_CSRF_SECRET's own length check, which defeats the
# point of forcing every operator to generate their own.
USHER_CSRF_SECRET=
