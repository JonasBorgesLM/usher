# Builds cmd/resource-server for the local docker-compose stack (RNF-06,
# RI-05). Same shape as Dockerfile.usher, and the same reason it stays
# this small: ADR-0013 keeps this binary a demo, not a product.
FROM golang:1.27.2-alpine AS build

ENV GOEXPERIMENT=jsonv2
ENV CGO_ENABLED=0

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go build -o /out/resource-server ./cmd/resource-server

FROM alpine:3.24
RUN apk add --no-cache ca-certificates
COPY --from=build /out/resource-server /usr/local/bin/resource-server
# A fixed numeric non-root UID (ADR-0022, decision 7): Kubernetes'
# runAsNonRoot can only verify a numeric user, and nothing here needs root.
USER 65532:65532
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/resource-server"]
